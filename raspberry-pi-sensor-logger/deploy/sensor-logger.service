[Unit]
Description=MLX90640, 4MZ-HH4 and USB Camera Logger
After=local-fs.target

[Service]
Type=simple
User=@@SENSOR_LOGGER_USER@@
WorkingDirectory="@@PROJECT_ROOT@@"
EnvironmentFile=-/etc/default/sensor-logger
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=@@PROJECT_ROOT@@/src"
ExecStart="@@VENV_PYTHON@@" -m sensor_logger --interval 5 --camera-interval 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027

[Install]
WantedBy=multi-user.target
