# Runtime artifacts (DB, datasets, runs, logs, generated outputs)
/runtime_data/*
!/runtime_data/.gitkeep

# Training / validation sample images (large local assets)
/sample/

# Unit / integration tests (keep local only)
/tests/

# Ultralytics / detector caches under data/
/data/

# Import inbox contents (keep README only)
/dataset_inbox/*
!/dataset_inbox/README.md

# Model weights under models/ (keep placeholders)
/models/*
!/models/.gitkeep
!/models/base/
/models/base/*
!/models/base/.gitkeep

# Local virtualenv if created inside this package
.venv/
venv/

# Python / test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated contact sheets / reports dropped in package root
*.png
*.jpg
*.jpeg
